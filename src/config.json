{
  "meta": {
    "flow": "Classic",
    "substituting_steps": {
      "+OpenROAD.GeneratePDN": "Project.ExtendPowerStripes",
      "+OpenROAD.ResizerTimingPostCTS": "Project.DiodesOnSramPins"
    }
  },
  "//1": "pdngen's connectivity check runs before Project.ExtendPowerStripes bridges the macro pins; LVS is the verdict",
  "PL_TARGET_DENSITY_PCT": 57,
  "CLOCK_PERIOD": 20,
  "CLOCK_PORT": "clk",

  "PL_RESIZER_HOLD_SLACK_MARGIN": 0.1,
  "GRT_RESIZER_HOLD_SLACK_MARGIN": 0.05,
  "PL_RESIZER_SETUP_SLACK_MARGIN": 0.25,
  "RUN_POST_GRT_RESIZER_TIMING": true,
  "MAX_TRANSITION_CONSTRAINT": 0.75,
  "MAX_FANOUT_CONSTRAINT": 8,
  "DESIGN_REPAIR_MAX_SLEW_PCT": 25,
  "DESIGN_REPAIR_REMOVE_BUFFERS": 1,
  "DESIGN_REPAIR_BUFFER_OUTPUT_PORTS": 0,

  "SYNTH_STRATEGY": "AREA 0",
  "USE_LIGHTER": 0,

  "RUN_LINTER": 1,
  "LINTER_INCLUDE_PDK_MODELS": 1,

  "//": "Heuristic diodes off; Project.DiodesOnSramPins places one diode on each SRAM input pin and rule-based repair handles the rest",
  "RUN_HEURISTIC_DIODE_INSERTION": 0,
  "RUN_ANTENNA_REPAIR": 1,
  "HEURISTIC_ANTENNA_THRESHOLD": 200,
  "DRT_ANTENNA_REPAIR_ITERS": 6,
  "DIODE_CELL": "sg13cmos5l_antennanp/A",
  "DIODE_PADDING": 2,
  "DPL_CELL_PADDING": 2,
  "CELL_PAD_EXCLUDE": [
    "RM*",
    "sg13cmos5l_a2*",
    "sg13cmos5l_and*",
    "sg13cmos5l_buf*",
    "sg13cmos5l_decap*",
    "sg13cmos5l_dfrbp*",
    "sg13cmos5l_dlhq*",
    "sg13cmos5l_dlhr*",
    "sg13cmos5l_dllr*",
    "sg13cmos5l_dlygate*",
    "sg13cmos5l_ebufn*",
    "sg13cmos5l_einvn*",
    "sg13cmos5l_fill*",
    "sg13cmos5l_inv*",
    "sg13cmos5l_lgcp*",
    "sg13cmos5l_mux*",
    "sg13cmos5l_nand*",
    "sg13cmos5l_nor*",
    "sg13cmos5l_o*",
    "sg13cmos5l_sdfbbp*",
    "sg13cmos5l_sdfrbp*",
    "sg13cmos5l_sighold*",
    "sg13cmos5l_slgcp*",
    "sg13cmos5l_tiehi*",
    "sg13cmos5l_tielo*",
    "sg13cmos5l_xnor*",
    "sg13cmos5l_xor*"
  ],

  "TOP_MARGIN_MULT": 1,
  "BOTTOM_MARGIN_MULT": 1,
  "LEFT_MARGIN_MULT": 6,
  "RIGHT_MARGIN_MULT": 6,
  "FP_SIZING": "absolute",
  "GRT_ALLOW_CONGESTION": 1,
  "DRT_SAVE_DRC_REPORT_ITERS": 4,
  "FP_IO_HLENGTH": 2,
  "FP_IO_VLENGTH": 2,
  "RUN_CTS": 1,

  "//": "44.96 um pitch = 4 x 11.24 um; VOFFSET 6.15 puts the first VPWR stripe at 9.03 um, aligning SRAM columns at x = 3.36 + 11.24*i",
  "FP_PDN_MULTILAYER": 0,
  "PDN_CFG": "dir::pdn_cfg.tcl",
  "FP_PDN_VPITCH": 44.96,
  "FP_PDN_VWIDTH": 2.1,
  "FP_PDN_VSPACING": 3.52,
  "FP_PDN_VOFFSET": 6.15,

  "EXTEND_STRIPES_SRAM_ALL_COLUMNS": false,
  "EXTEND_STRIPES_SRAM_ARRAY_EVERY_OTHER": true,
  "EXTEND_STRIPES_PIN_FACE_MARGIN": 0,

  "FP_MACRO_HORIZONTAL_HALO": 2.0,
  "FP_MACRO_VERTICAL_HALO": 0.48,

  "MACROS": {
    "RM_IHPSG13_2P_512x16_c2_bm_bist": {
      "instances": {
        "u_asic_top.u_imem.sram": {
          "location": [
            48.32,
            3.78
          ],
          "orientation": "FS"
        }
      },
      "gds": [
        "dir::../macro/RM_IHPSG13_2P_512x16_c2_bm_bist/RM_IHPSG13_2P_512x16_c2_bm_bist.gds"
      ],
      "lef": [
        "dir::../macro/RM_IHPSG13_2P_512x16_c2_bm_bist/RM_IHPSG13_2P_512x16_c2_bm_bist.lef"
      ],
      "lib": {
        "nom_typ_1p20V_25C": [
          "dir::../macro/RM_IHPSG13_2P_512x16_c2_bm_bist/RM_IHPSG13_2P_512x16_c2_bm_bist_typ_1p20V_25C.lib"
        ],
        "nom_fast_1p32V_m40C": [
          "dir::../macro/RM_IHPSG13_2P_512x16_c2_bm_bist/RM_IHPSG13_2P_512x16_c2_bm_bist_fast_1p32V_m55C.lib"
        ],
        "nom_slow_1p08V_125C": [
          "dir::../macro/RM_IHPSG13_2P_512x16_c2_bm_bist/RM_IHPSG13_2P_512x16_c2_bm_bist_slow_1p08V_125C.lib"
        ]
      },
      "nl": [],
      "spef": {},
      "spice": [
        "dir::../macro/RM_IHPSG13_2P_512x16_c2_bm_bist/RM_IHPSG13_2P_512x16_c2_bm_bist.cdl"
      ]
    }
  },

  "PDN_MACRO_CONNECTIONS": [
    "u_asic_top\\.u_imem\\.sram VPWR VGND VDD! VSS!",
    "u_asic_top\\.u_imem\\.sram VPWR VGND VDDARRAY! VSS!"
  ],

  "PNR_CORNERS": [
    "nom_typ_1p20V_25C",
    "nom_slow_1p08V_125C"
  ],

  "VDD_PIN": "VPWR",
  "GND_PIN": "VGND",

  "//": "Keep router off Metal2-Metal4 over the SRAM body (x: 48.32..450.93, y: 3.78..220.5) while leaving the top pin edge at y~223.55 accessible",
  "ROUTING_OBSTRUCTIONS": [
    "Metal2 48.32 3.78 450.93 220.5",
    "Metal3 48.32 3.78 450.93 220.5",
    "Metal4 48.32 3.78 450.93 220.5"
  ],

  "//": "Sign-off waivers and DRC/LVS settings matching the reference repo",
  "ERROR_ON_PDN_VIOLATIONS": 0,
  "ERROR_ON_ILLEGAL_OVERLAPS": 0,
  "RUN_MAGIC_DRC": 0,
  "ERROR_ON_MAGIC_DRC": false,
  "MAGIC_MACRO_STD_CELL_SOURCE": "PDK",
  "MAGIC_EXT_ABSTRACT_CELLS": ["RM_IHPSG13_.*"],
  "MAGIC_DEF_LABELS": 0,
  "MAGIC_WRITE_LEF_PINONLY": 1,

  "RUN_KLAYOUT_XOR": 0,
  "RUN_KLAYOUT_DRC": 0
}